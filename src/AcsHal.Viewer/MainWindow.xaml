<Window x:Class="AcsHal.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AcsHal.Viewer"
        xmlns:vm="clr-namespace:AcsHal.Viewer.ViewModels"
        Title="ACS HAL Viewer" Width="1280" Height="860" MinWidth="1000" MinHeight="680"
        Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13"
        Closing="OnClosing">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <local:FractionToPixelsConverter x:Key="FractionToPixels" />
        <local:BoolToBrushConverter x:Key="BoolToBrush" />
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:FileNameConverter x:Key="FileName" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DADDE2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="34" />
        </Style>
        <Style x:Key="Lamp" TargetType="Ellipse">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LampLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Connection bar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Disable all" Command="{Binding DisableAllCommand}" IsEnabled="{Binding IsConnected}" />
                    <Button Content="KILL ALL" Command="{Binding KillAllCommand}" IsEnabled="{Binding IsConnected}"
                            Background="#C62828" Foreground="White" FontWeight="Bold" Padding="16,4" Margin="0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Config" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding ConfigFiles}" SelectedItem="{Binding SelectedConfig}" Width="190" Margin="0,0,8,0"
                              IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource FileName}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Connect" Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBool}}" />
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding IsConnected}" />
                    <TextBlock Text="{Binding ModeText}" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0" Foreground="#1565C0" />
                    <TextBlock Text="{Binding ControllerInfo}" VerticalAlignment="Center" Foreground="#555" />
                    <TextBlock Text="  working..." VerticalAlignment="Center" Foreground="#888"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Log, terminal and raw axes -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Height="230" Margin="0">
            <TabControl BorderThickness="0">
                <TabItem Header="Log / terminal">
                    <DockPanel Margin="0,6,0,0">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendTerminalCommand}" Margin="6,0,0,0" IsEnabled="{Binding IsConnected}" />
                            <TextBox Text="{Binding TerminalInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" IsEnabled="{Binding IsConnected}"
                                     ToolTip="ACSPL+ command, e.g. ?FPOS(0)  or  ?MFLAGS(0).25. On hardware only ? queries are sent.">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SendTerminalCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12" BorderThickness="0" />
                    </DockPanel>
                </TabItem>
                <TabItem Header="Controller axes">
                    <DataGrid ItemsSource="{Binding PhysicalAxes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" BorderThickness="0" Margin="0,6,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Axis" Binding="{Binding Index}" Width="50" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="80" />
                            <DataGridTextColumn Header="FPOS" Binding="{Binding Position, StringFormat={}{0:0.0000}}" Width="110" />
                            <DataGridTextColumn Header="FVEL" Binding="{Binding Velocity, StringFormat={}{0:0.000}}" Width="100" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70" />
                            <DataGridCheckBoxColumn Header="Moving" Binding="{Binding Moving}" Width="70" />
                            <DataGridTextColumn Header="Faults" Binding="{Binding Faults}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="470" />
            </Grid.ColumnDefinitions>

            <!-- Machine picture -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Machine" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- XY table, top-down. Click to move there. -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Foreground="#555" Margin="0,0,0,4">
                                <Run Text="XY table (top view) · X " /><Run Text="{Binding XAxis.Position, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                <Run Text=" · Y " /><Run Text="{Binding YAxis.Position, StringFormat={}{0:0.000}, Mode=OneWay}" />
                                <Run Text=" mm · yaw X " /><Run Text="{Binding XAxis.Yaw, StringFormat={}{0:0.0000}, Mode=OneWay}" />
                                <Run Text=" / Y " /><Run Text="{Binding YAxis.Yaw, StringFormat={}{0:0.0000}, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Bottom" Foreground="#888" FontSize="11" Margin="0,4,0,0"
                                       Text="Click the table to move X and Y there (simulator, gantries engaged and enabled)." />
                            <Viewbox Stretch="Uniform">
                                <Canvas x:Name="XyCanvas" Width="360" Height="300" Background="#EEF2F7" ClipToBounds="True"
                                        MouseLeftButtonDown="OnXyCanvasClick" Cursor="Cross">
                                    <Rectangle Width="360" Height="300" Stroke="#9AA5B1" StrokeThickness="1" />
                                    <!-- X gantry beam (moves in X), Y carriage line (moves in Y) -->
                                    <Rectangle Width="6" Height="300" Fill="#3A6EA5" Opacity="0.55"
                                               Canvas.Left="{Binding XAxis.Fraction, Converter={StaticResource FractionToPixels}, ConverterParameter=360}">
                                        <Rectangle.RenderTransform><TranslateTransform X="-3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="360" Height="6" Fill="#2E7D32" Opacity="0.55"
                                               Canvas.Top="{Binding YAxis.Fraction, Converter={StaticResource FractionToPixels}, ConverterParameter=-300}">
                                        <Rectangle.RenderTransform><TranslateTransform Y="-3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Ellipse Width="16" Height="16" Fill="#C62828" Stroke="White" StrokeThickness="2"
                                             Canvas.Left="{Binding XAxis.Fraction, Converter={StaticResource FractionToPixels}, ConverterParameter=360}"
                                             Canvas.Top="{Binding YAxis.Fraction, Converter={StaticResource FractionToPixels}, ConverterParameter=-300}">
                                        <Ellipse.RenderTransform><TranslateTransform X="-8" Y="-8" /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="X →" Canvas.Left="320" Canvas.Top="282" Foreground="#6B7785" FontSize="11" />
                                    <TextBlock Text="Y ↑" Canvas.Left="4" Canvas.Top="4" Foreground="#6B7785" FontSize="11" />
                                </Canvas>
                            </Viewbox>
                        </DockPanel>

                        <!-- Stroke bars: Z, Theta, doors -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding StrokeAxes}" Margin="16,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SingleAxisViewModel}">
                                    <DockPanel Width="64" Margin="0,0,6,0">
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Position, StringFormat={}{0:0.000}}" HorizontalAlignment="Center" Foreground="#555" />
                                        <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Center" Foreground="#888" FontSize="11">
                                            <Run Text="{Binding TravelMin, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding TravelMax, Mode=OneWay}" />
                                        </TextBlock>
                                        <ProgressBar Orientation="Vertical" Width="22" Margin="0,4" HorizontalAlignment="Center"
                                                     Minimum="{Binding TravelMin}" Maximum="{Binding TravelMax}" Value="{Binding Position, Mode=OneWay}"
                                                     Foreground="#3A6EA5" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Axis controls -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Jog speed" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding JogSpeed}" Width="60" Margin="0,0,4,0" />
                        <TextBlock Text="mm/s     Move speed" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding MoveSpeed}" Width="60" Margin="0,0,4,0" />
                        <TextBlock Text="mm/s" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MachineAxes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MachineAxisViewModel}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" FontSize="16"
                                                       Text="{Binding Position, StringFormat={}{0:0.000} mm}" />
                                            <TextBlock Style="{StaticResource CardTitle}" Margin="0">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding Motors, Mode=OneWay, FallbackValue=''}" FontSize="11" FontWeight="Normal" Foreground="#888" />
                                            </TextBlock>
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,6">
                                            <Ellipse Style="{StaticResource Lamp}" Fill="{Binding Enabled, Converter={StaticResource BoolToBrush}, ConverterParameter=#2E7D32}" />
                                            <TextBlock Style="{StaticResource LampLabel}" Text="Enabled" />
                                            <Ellipse Style="{StaticResource Lamp}" Fill="{Binding Moving, Converter={StaticResource BoolToBrush}, ConverterParameter=#1565C0}" />
                                            <TextBlock Style="{StaticResource LampLabel}" Text="Moving" />
                                            <Ellipse Style="{StaticResource Lamp}" Fill="{Binding InPosition, Converter={StaticResource BoolToBrush}, ConverterParameter=#2E7D32}" />
                                            <TextBlock Style="{StaticResource LampLabel}" Text="In pos" />
                                            <Ellipse Style="{StaticResource Lamp}" Fill="{Binding HasFault, Converter={StaticResource BoolToBrush}, ConverterParameter=#C62828}" />
                                            <TextBlock Style="{StaticResource LampLabel}" Text="Fault" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsGantry, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse Style="{StaticResource Lamp}" Fill="{Binding IsEngaged, Converter={StaticResource BoolToBrush}, ConverterParameter=#6A1B9A, FallbackValue=Gray}" />
                                                <TextBlock Style="{StaticResource LampLabel}">
                                                    <Run Text="Gantry · yaw" /> <Run Text="{Binding Yaw, Mode=OneWay, StringFormat={}{0:0.0000}, FallbackValue=''}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Faults}" Foreground="#C62828" TextWrapping="Wrap"
                                                   Visibility="{Binding HasFault, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Enable" Command="{Binding EnableCommand}" IsEnabled="{Binding CanMove}" />
                                            <Button Content="Disable" Command="{Binding DisableCommand}" IsEnabled="{Binding CanMove}" />
                                            <Button Content="Clear faults" Command="{Binding ClearFaultsCommand}" IsEnabled="{Binding CanMove}" />
                                            <Button Content="Halt" Command="{Binding HaltCommand}" IsEnabled="{Binding CanMove}" />
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsGantry, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="Engage" Command="{Binding EngageCommand, FallbackValue={x:Null}}"
                                                        ToolTip="Disable both motors and switch to true-gantry mode" />
                                                <Button Content="Release" Command="{Binding ReleaseCommand, FallbackValue={x:Null}}"
                                                        ToolTip="Disable both motors and return to independent axes" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="◀ Jog" Tag="-1" IsEnabled="{Binding CanMove}" ToolTip="Hold to jog"
                                                    PreviewMouseLeftButtonDown="OnJogPress" PreviewMouseLeftButtonUp="OnJogRelease" MouseLeave="OnJogRelease" />
                                            <Button Content="Jog ▶" Tag="1" IsEnabled="{Binding CanMove}" ToolTip="Hold to jog"
                                                    PreviewMouseLeftButtonDown="OnJogPress" PreviewMouseLeftButtonUp="OnJogRelease" MouseLeave="OnJogRelease" />
                                            <TextBlock Text="Target" VerticalAlignment="Center" Margin="10,0,6,0" />
                                            <TextBox Text="{Binding Target}" Width="70" VerticalContentAlignment="Center" />
                                            <Button Content="Move" Command="{Binding MoveCommand}" IsEnabled="{Binding CanMove}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
