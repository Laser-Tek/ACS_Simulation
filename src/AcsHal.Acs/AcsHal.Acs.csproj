<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AcsHal.Core\AcsHal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ACS.SPiiPlusNET">
      <HintPath>$(AcsNetLibPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckAcsLibrary" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AcsNetLibPath)')"
           Text="ACS .NET library not found at '$(AcsNetLibPath)'. Install the SPiiPlus ADK Suite or set AcsNetLibPath in Directory.Build.props." />
  </Target>

</Project>
