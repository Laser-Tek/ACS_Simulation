{
  // Machine configuration for the ACS SPiiPlus simulator.
  //
  // The simulator behaves like 4-axis servo processors with fixed true-gantry pairs 0<->2 and 1<->3
  // (SETCONF(267) has no effect there), so the gantry motors are placed on those pairs:
  //   X gantry: X1 = 0 (COG), X2 = 2 (yaw)
  //   Y gantry: Y1 = 1 (COG), Y2 = 3 (yaw)
  // The real controller will likely pair differently; see machine.hw.json.
  //
  // Mechanics match machine.hw.json. The simulator stores EFAC but does not rescale positions with it.

  "connection": {
    "mode": "Simulator"
  },

  "axes": [
    { "name": "X1",    "index": 0, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },
    { "name": "Y1",    "index": 1, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },
    { "name": "X2",    "index": 2, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },
    { "name": "Y2",    "index": 3, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },
    { "name": "Z",     "index": 4, "kind": "Linear", "mechanics": { "type": "BallScrew", "leadMm": 5, "countsPerMotorRev": 131072 } },
    { "name": "Theta", "index": 5, "kind": "Linear", "mechanics": { "type": "BallScrew", "leadMm": 5, "countsPerMotorRev": 131072 } },
    { "name": "Door1", "index": 6, "kind": "Door" },
    { "name": "Door2", "index": 7, "kind": "Door" }
  ],

  "gantries": [
    { "name": "X", "cogAxis": "X1", "yawAxis": "X2" },
    { "name": "Y", "cogAxis": "Y1", "yawAxis": "Y2" }
  ]
}
