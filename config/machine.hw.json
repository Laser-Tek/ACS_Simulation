{
  // Machine configuration for the real 8-axis CMxa + UDMdx system.
  // Axis indices and the IP address are PLACEHOLDERS until checked against the real controller
  // (MMI > System Setup). The smoke test only reads from hardware; it never moves anything.
  //
  // Positions are in mm. "mechanics" gives the encoder scale the controller must use (EFAC, set and
  // saved in MMI during commissioning); the HAL verifies it on connect but does not write it here.

  "connection": {
    "mode": "Ethernet",
    "address": "10.0.0.100",      // TBD: controller IP
    "port": 701
  },

  "axes": [
    // X/Y gantries: linear motors, one linear encoder per motor. TBD: encoder resolution.
    { "name": "X1",    "index": 0, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },
    { "name": "X2",    "index": 1, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },
    { "name": "Y1",    "index": 2, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },
    { "name": "Y2",    "index": 3, "kind": "Linear", "mechanics": { "type": "LinearMotor", "encoderResolutionMm": 0.0001 } },

    // Z and Theta: rotary servo motor driving a ball screw, controlled in mm of screw travel.
    // TBD: screw lead, motor encoder counts/rev, gearing; Z brake / safe height.
    { "name": "Z",     "index": 4, "kind": "Linear", "mechanics": { "type": "BallScrew", "leadMm": 5, "countsPerMotorRev": 131072 } },
    { "name": "Theta", "index": 5, "kind": "Linear", "mechanics": { "type": "BallScrew", "leadMm": 5, "countsPerMotorRev": 131072 } },

    // Doors: servo motors. TBD: drive mechanism (screw/belt), open/closed positions, interlocks.
    { "name": "Door1", "index": 6, "kind": "Door" },
    { "name": "Door2", "index": 7, "kind": "Door" }
  ],

  // True gantry (MFLAGS.#GANTRY): needs two identical motors with identical encoders, both on the
  // same servo processor (e.g. the same UDMdx). Which index becomes COG/yaw depends on the servo
  // processor type: 0<->1 on 2-axis servo processors, 0<->2 and 1<->3 on 4-axis ones.
  "gantries": [
    { "name": "X", "cogAxis": "X1", "yawAxis": "X2" },
    { "name": "Y", "cogAxis": "Y1", "yawAxis": "Y2" }
  ]
}
