<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The ACS native library (ACSCL_x64.dll) is 64-bit. -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      ACS SPiiPlus .NET library, checked in under lib\ACS so a fresh clone builds without the ADK.
      Keep it at the same version as the installed ADK (see lib\ACS\VERSION.txt). To build against
      the installed copy instead:
        dotnet build -p:AcsNetLibPath="C:\Program Files (x86)\ACS Motion Control\SPiiPlus Runtime Kit\CommonFiles\ACS.SPiiPlusNET6.dll"
    -->
    <AcsNetLibPath Condition="'$(AcsNetLibPath)' == ''">$(MSBuildThisFileDirectory)lib\ACS\ACS.SPiiPlusNET6.dll</AcsNetLibPath>
  </PropertyGroup>
</Project>
